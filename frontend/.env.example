# Vite development requests to /api/v1 are proxied to the Node API by vite.config.ts.
# Leave VITE_API_URL unset to use that proxy. Set this only when intentionally
# calling an API at a different origin directly.
# VITE_API_URL=http://127.0.0.1:4173/api/v1
# VITE_API_PROXY_TARGET=http://127.0.0.1:4173
