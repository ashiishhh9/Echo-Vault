PORT=4173
HOST=
TRUST_PROXY=false
DATABASE_PATH=database/digital-time-capsule.sqlite
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
AI_SERVICE_URL=http://127.0.0.1:8100
# Required in production; use the same random secret in ai-service/.env.
AI_SERVICE_API_KEY=
AI_TIMEOUT_MS=120000
EMBEDDING_REQUEST_TIMEOUT_MS=30000
MEDIA_STORAGE_DIR=storage/media
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional Resend unlock email delivery (disabled by default)
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173
EMAIL_NOTIFICATIONS_ENABLED=false

# Optional Python compatibility API configuration:
APP_NAME=Digital Time Capsule API
API_V1_PREFIX=/api/v1
PYTHON_DATABASE_PATH=./data/capsules.sqlite3
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development
DEBUG=true
